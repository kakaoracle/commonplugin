{
  "manifest_version": 3,
  "name": "kakaoracle",
  "version": "0.10.5",
  "description": "kakaoracle：粉笔、CSDN、知乎页面增强与 JSON 美化工具。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://spa.fenbi.com/*",
    "https://www.fenbi.com/*",
    "https://blog.csdn.net/*",
    "https://www.zhihu.com/*",
    "https://tiku.fenbi.com/*",
    "https://ke.fenbi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "kakaoracle",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spa.fenbi.com/ti/*",
        "https://blog.csdn.net/*",
        "https://www.zhihu.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
